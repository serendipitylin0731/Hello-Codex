<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HelloCodex</AssemblyName>
    <RootNamespace>HelloCodex</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <Authors>serendipitylin0731</Authors>
    <Product>Hello! Codex</Product>
    <Description>为 ChatGPT Plus 订阅用户设计的 Codex 额度启动器</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HelloCodex.Core\HelloCodex.Core.csproj" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
</Project>
