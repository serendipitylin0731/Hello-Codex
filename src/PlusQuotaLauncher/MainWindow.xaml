<Window x:Class="PlusQuotaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChatGPT Plus 额度启动器"
        Width="1080" Height="740"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Icon="Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E9F1" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1769E0" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E8ECF2" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#CDD5E1" />
        <SolidColorBrush x:Key="SoftBackgroundBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="AdvancedBackgroundBrush" Color="#F8FAFD" />
        <SolidColorBrush x:Key="QuotaBackgroundBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="QuotaHeadingBrush" Color="#0A4F96" />
        <SolidColorBrush x:Key="QuotaMutedBrush" Color="#52677F" />
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#EAF2FE" />
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#1559B7" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF2D7" />
        <SolidColorBrush x:Key="WarningForegroundBrush" Color="#9A5B00" />
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#C8D0DC" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#D4E5F8" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#22324B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftBackgroundBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#AFCDF8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="TextBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#1769E0" />
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#245F9E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1769E0" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="12,0,42,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Margin="10,0,42,0"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     BorderThickness="0"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="0,9,9,0">
                                            <Path Width="9" Height="5" Stretch="Fill" Fill="{DynamicResource MutedBrush}"
                                                  Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource FieldBackgroundBrush}"
                                        BorderBrush="{DynamicResource FieldBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320"
                                        Margin="0,4,0,0"
                                        Padding="3">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#1769E0" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,7,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack" Width="36" Height="21" CornerRadius="11"
                                    Background="{DynamicResource SwitchOffBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="15" Height="15" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0" Effect="{x:Null}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#1769E0" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#E8F3FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonChrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonChrome" Property="Background" Value="#2A6DA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonChrome" Property="Background" Value="#1B568E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="11">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource FieldBorderBrush}"
                                                        CornerRadius="5" Margin="2,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#092E61" Offset="0" />
                    <GradientStop Color="#0A3F7A" Offset="0.58" />
                    <GradientStop Color="#075B9E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBarDrag_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                            <Image Source="Assets/logo.png" Width="19" Height="19" Stretch="Uniform" />
                            <TextBlock Text="ChatGPT Plus 额度启动器" Foreground="#BFD8EE" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource TitleBarButton}"
                                AutomationProperties.Name="最小化" Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                                AutomationProperties.Name="最大化" Click="MaximizeButton_Click">
                            <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="15" />
                        </Button>
                        <Button x:Name="CloseButton" Content="✕" Style="{StaticResource TitleBarButton}"
                                AutomationProperties.Name="关闭" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="30,4,30,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="Assets/logo.png" Width="50" Height="50" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="ChatGPT Plus 额度启动器"
                                   Foreground="White"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Border Margin="14,1,0,0" Padding="9,4" CornerRadius="10" Background="#1F6FB1" VerticalAlignment="Center">
                            <TextBlock Text="PLUS" Foreground="#CDEBFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#143D6C" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#8CA0B8" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStatusText" Text="等待检查" Foreground="#D7E8F7" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="额度概览" Foreground="{DynamicResource InkBrush}" FontSize="21" FontWeight="Bold" />
                        <Border x:Name="StateBadgeBorder" Grid.Column="1" Background="#EEF1F5" CornerRadius="12" Padding="12,6">
                            <TextBlock x:Name="StateBadgeText" Text="未启动" Foreground="#526073" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="SummaryText" Grid.Row="1" Text="等待首次额度检查"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Border Grid.Row="2" CornerRadius="16" Margin="0,22,0,0" Padding="22,20"
                            Background="{DynamicResource QuotaBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="五小时额度" Foreground="{DynamicResource QuotaMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="QuotaText" Text="尚未读取" Foreground="{DynamicResource QuotaHeadingBrush}" FontSize="30" FontWeight="Bold" Margin="0,5,0,0" />
                            <ProgressBar x:Name="QuotaProgress" Height="7" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" Foreground="#1769E0" Background="{DynamicResource ProgressTrackBrush}"
                                         BorderThickness="0" Margin="0,14,0,0" />
                            <TextBlock x:Name="ResetText" Text="重置时间将在检查后显示"
                                       Foreground="{DynamicResource QuotaMutedBrush}" FontSize="13" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource SoftBackgroundBrush}" CornerRadius="11" Padding="13,10" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AccountDot" Width="8" Height="8" Fill="#A7B2C2" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccountText" Text="尚未读取账户信息" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="4" Margin="0,22,0,0">
                        <Button x:Name="MonitorButton" Style="{StaticResource ModernButton}" Click="MonitorButton_Click" Margin="0,0,9,9">
                            <TextBlock x:Name="MonitorButtonText" Text="启动监控" />
                        </Button>
                        <Button x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Click="CheckButton_Click" Margin="0,0,9,9">立即检查</Button>
                        <Button x:Name="ManualSendButton" Style="{StaticResource WarningButton}" Click="ManualSendButton_Click" Margin="0,0,0,9">手动发送</Button>
                    </WrapPanel>

                    <Border Grid.Row="6" Background="{DynamicResource SoftBackgroundBrush}" CornerRadius="11" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecentEventText" Text="暂无事件" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="诊断日志" Style="{StaticResource GhostButton}"
                                    Padding="11,6" MinHeight="0" Margin="10,0,0,0" Click="OpenLogButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="26,22,26,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="使用设置" Foreground="{DynamicResource InkBrush}" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="常用选项保持简洁，高级参数可按需展开。"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button x:Name="SaveButton" Grid.Column="1" Content="保存设置" Style="{StaticResource ModernButton}"
                                Padding="16,9" Click="SaveButton_Click" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="26,0,20,24">
                        <StackPanel>
                            <TextBlock Text="时区" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TimeZoneCombo" />

                            <Grid Margin="0,18,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="免打扰时段" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="＋ 添加时间段" Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" MinHeight="0" Click="AddDisabledRangeButton_Click" />
                            </Grid>
                            <ItemsControl x:Name="DisabledRangesItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SoftBackgroundBrush}" CornerRadius="10"
                                                Padding="10" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="至" Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Center" />
                                                <Button Grid.Column="3" Content="移除" Style="{StaticResource GhostButton}"
                                                        Foreground="{DynamicResource MutedBrush}" Padding="11,7" MinHeight="0"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="RemoveDisabledRangeButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="多个时段按并集生效；支持跨午夜。未添加时段则不暂停自动检查。"
                                       Style="{StaticResource HintText}" Margin="0,0,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="发送内容" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <TextBox x:Name="MessageBox" />

                            <TextBlock Text="外观" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" />

                            <CheckBox x:Name="MonitorOnLaunchBox" Content="打开程序后自动监控" Margin="0,18,0,5" />
                            <CheckBox x:Name="AutoStartBox" Content="随 Windows 登录自动启动" Margin="0,5,0,7" />

                            <Button x:Name="AdvancedToggleButton" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Padding="14,10" Margin="0,15,0,0"
                                    Click="AdvancedToggleButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="高级设置" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AdvancedChevron" Text="⌄" FontSize="16" Margin="8,-1,0,0" />
                                </StackPanel>
                            </Button>

                            <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{DynamicResource AdvancedBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12"
                                    Padding="16" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Codex 模型" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ModelBox" />

                                    <TextBlock Text="思考强度" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <ComboBox x:Name="EffortCombo" IsEditable="True" />

                                    <TextBlock Text="额度桶" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <TextBox x:Name="LimitIdBox" />

                                    <TextBlock Text="Codex CLI" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CodexPathBox" />
                                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}"
                                                Padding="14,9" Margin="9,0,0,0" Click="BrowseCodexButton_Click" />
                                    </Grid>

                                    <TextBlock Text="检查间隔（秒）" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" />
                                    <TextBox x:Name="PollSecondsBox" Width="130" HorizontalAlignment="Left" />
                                    <TextBlock Text="允许 30–86400 秒，默认 120 秒。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
